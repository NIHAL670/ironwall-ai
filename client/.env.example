# Copy this file to .env and adjust as needed.
# All of these are read in src/config/env.js and imported from there.

# --- API ---------------------------------------------------------------------
# Base URL the frontend calls. Leave as /api to use the Vite dev proxy
# (no CORS setup needed on the ML server). Or set a full URL for a deployed API,
# e.g. https://your-host/api  (that server must then send CORS headers).
VITE_API_BASE_URL=/api

# Detection endpoint path, relative to VITE_API_BASE_URL.
VITE_DETECT_PATH=/voice-detection

# Where the Vite dev proxy forwards /api and /health — the running FastAPI
# server in services/ml. Only used in development.
VITE_PROXY_TARGET=http://localhost:8000

# Optional API key, sent as the "x-api-key" header on every request.
VITE_API_KEY=

# Per-request timeout in milliseconds.
VITE_REQUEST_TIMEOUT_MS=120000

# --- Live monitor ------------------------------------------------------------
# Seconds of audio per live segment. 5s matches the model's analysis window
# (services/ml/config.py -> MAX_DURATION).
VITE_LIVE_SEGMENT_SECONDS=5

# Sample rate sent to the API. The model expects 16000 (config.py -> SR).
VITE_TARGET_SAMPLE_RATE=16000

# Max concurrent in-flight segment requests before segments are dropped.
# This is backpressure: on CPU the model runs at roughly 1x real time, so
# without it the queue would grow without bound during a long session.
VITE_MAX_INFLIGHT_SEGMENTS=2

# Seconds of audio scored for the end-of-session verdict (most recent window).
# Keep well under VITE_REQUEST_TIMEOUT_MS — CPU inference is ~1x real time.
VITE_MAX_SESSION_SECONDS=60

# --- UI ----------------------------------------------------------------------
# How often the header polls /health, in milliseconds.
VITE_HEALTH_POLL_MS=15000

VITE_APP_NAME=IronWall AI
